# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Secret Salt for Anonymity (HMAC author_hash)
# TUYỆT ĐỐI KHÔNG ĐƯỢC ĐỂ LỘ RA CLIENT
ANONYMOUS_SALT_SECRET=change-this-to-a-very-strong-random-secret-key-32-bytes
